services:
  cinesnip:
    build: .
    # Pinned so Compose doesn't auto-suffix it (cinesnip-1, etc). Running a
    # second CineSnip checkout on this same Docker host? Rename this to
    # something unique first, or the second `docker compose up` will fail
    # with "container name ... already in use".
    container_name: cinesnip
    env_file:
      - .env
    ports:
      # Local web app — wizard (Section 14) + /generate manual clip UI.
      # Deliberately opted into LAN exposure here (binds all interfaces,
      # not just 127.0.0.1) so other devices on this network can reach
      # /generate and reconfigure setup. This is still only as safe as the
      # LAN itself: nothing at the app layer gates /wizard/restart (raw
      # token entry) beyond this port binding — see app/main.py's comment
      # on why an app-level "reject non-LAN" check doesn't work on this
      # Docker topology. Do NOT port-forward 1919 on the router — that
      # would expose it to the internet, not just the LAN. The worker API
      # itself stays loopback-only *inside* the container with no port
      # published at all (Section 9), unaffected by this.
      - "1919:1919"
    volumes:
      # Read-write: the wizard writes these directly on first run (Section
      # 14). .env didn't need a bind mount before the wizard existed —
      # env_file above is read straight off the host by Docker Compose at
      # container start, but the running container itself had no way to
      # edit that host file until now.
      #
      # This is a deliberate, accepted trade-off, not an oversight: these
      # two files stay writable for the container's ENTIRE lifetime, not
      # just during the one-time wizard phase (compose has no way to
      # remount something read-only partway through a container's life).
      # That means the long-running bot/worker process technically retains
      # write access to its own secrets/config after setup completes, even
      # though nothing in normal operation writes to them again. Accepted
      # because (a) this is a personal, single-owner install running on the
      # installer's own machine (Section 11), not a multi-tenant service,
      # and (b) the planned /setup reconfiguration route (decision #6) will
      # need the same write access anyway, so scoping it to "wizard phase
      # only" would just be re-added later. Revisit if this project ever
      # moves toward a threat model where the bot/worker process itself is
      # untrusted relative to its own config.
      - ./.env:/app/.env
      - ./config.yaml:/app/config.yaml
      # One read-only bind mount per media folder your libraries span (see
      # config.yaml's path_mappings, README step 5). Add/remove entries to
      # match your own layout — these are just examples:
      - "/path/to/your/movies:/media/movies:ro"
      - "/path/to/your/tv-shows:/media/tv:ro"
      - ./scratch:/app/scratch
      - ./cache:/app/cache
    restart: unless-stopped
    labels:
      # This image is built locally (`build: .`), not pulled from a
      # registry — Watchtower's default "monitor everything" mode tries
      # to `docker pull` it anyway and fails, since there's nothing to
      # pull from. This label is Watchtower's standard opt-out.
      - "com.centurylinklabs.watchtower.enable=false"
