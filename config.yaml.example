# One entry per Plex library CineSnip should search. `name` must match the
# library's title in Plex exactly (case-sensitive) — this is also how a
# result is labeled when the same title exists in more than one library
# (e.g. a regular Movies library and a separate 4K one).
#
# Under path_mappings, add one entry per folder that library spans.
# plex_prefix must match exactly how Plex reports the path (Windows-style
# backslashes if Plex runs on Windows). container_path is where that same
# folder is bind-mounted inside the Docker container (see docker-compose.yml).
# A library that only lives in one folder needs only one entry.
#
# three_d_format (optional, default "none") tags a library as containing
# 3D encodes that pack both eyes into a single frame — "side_by_side" or
# "over_under". Without this, a 3D file renders as a squished/doubled
# frame instead of a normal flat clip. Files that carry their own packing
# tag (e.g. a Matroska StereoMode element) are auto-detected at render
# time and override this default — it's only the fallback for untagged
# files, which real-world 3D rips often are. If your library's files use
# more than one packing and some are untagged, there's currently no
# per-file override beyond this library-wide default.
libraries:
  - name: "Movies"
    path_mappings:
      - plex_prefix: "D:\\Movies"
        container_path: "/media/movies"
  - name: "TV Shows"
    path_mappings:
      - plex_prefix: "D:\\TV Shows"
        container_path: "/media/tv"

# duration_seconds is used for timecode-driven clips. A quote-driven clip
# instead uses the matched subtitle line's own start/end, clamped to
# [min_duration_seconds, max_duration_seconds] — duration_seconds itself
# is clamped to that same range too.
# format is the default output when the user doesn't pick one via
# /cinesnip's format: option ("gif", "mp4", or "webm"). gif is the default
# because it's the only one of the three Discord actually autoplays/loops
# inline and lets you "Add to Favorites" in the GIF picker — mp4/webm are
# much smaller but show as a real video player (play button, volume
# slider) instead, confirmed against real Discord behavior.
render_defaults:
  duration_seconds: 4
  fps: 15
  width: 480
  min_duration_seconds: 1
  max_duration_seconds: 15
  format: gif

# Embedded-subtitle extraction has no fast seek — it reads sequentially
# through the whole file. 300s gives real headroom for a large remux over a
# slower mount (e.g. WSL2-bridged drives) — a real 39GB 2160p HDR remux
# measured at 251.6s. Raise further if you see timeouts on very large files
# (well past 40-50GB is plausible for some 2160p remuxes).
subtitle_defaults:
  extraction_timeout_seconds: 300

# Fuzzy quote-search tuning. min_score is a noise floor (candidates scoring
# below it are dropped entirely); confident_score is presentation-only — it
# only controls whether the Discord UI treats the top match as good enough
# to lead with, or opens straight to "show other matches".
quote_match:
  candidate_limit: 8
  min_score: 50
  confident_score: 85
  max_window_gap_seconds: 3
  context_lines: 1
  # /snip search only: when library_sync is enabled, an extending search
  # extracts up to this many not-yet-cached movie titles per request before
  # stopping (a "search N more" follow-up covers the rest).
  library_extend_cap: 25

worker:
  port: 8000

# Optional, off by default. Periodically checks Plex for library changes
# (via each library's own updatedAt timestamp — cheap, and confirmed not to
# fire on routine metadata refreshes, only genuine adds/removals) and keeps
# the subtitle cache in sync automatically: new titles get their subtitles
# extracted and cached, and titles removed from Plex have their cache
# entries deleted. Two safety checks (a mount-reachability check, and a
# spot-check of titles Plex still reports as present) must both pass before
# any deletion happens, specifically to avoid mistaking a Plex outage or a
# dead drive for genuine content removal. See README.md for the full
# explanation before enabling this.
library_sync:
  enabled: false
  interval_hours: 24
