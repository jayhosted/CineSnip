# Secrets / local config
.env
config.yaml

# Python
__pycache__/
*.pyc
.venv/
venv/

# Runtime data
*.db
*.sqlite3
/tmp/
/cache/
/scratch/

# Testing
.pytest_cache/

# Claude Code local settings/skills (installed tooling, personal hook config)
.claude/

# Internal dev docs — personal setup details / forensic build notes, not
# needed to install or run CineSnip. Kept locally for Claude Code context.
/CLAUDE.md
/DESIGN.md
/PRODUCT.md
/docs/

# Skill/plugin-generated local state — the tooling itself belongs at the
# global Claude Code config level, not duplicated per-project.
.impeccable/
docs/superpowers/

# Local dev-only compose override (bind-mounts ./app for hot reload) —
# Compose auto-merges it, so it must never reach another installer's clone.
docker-compose.override.yml

# OS / editor cruft
.DS_Store
*.log
