DISCORD_TOKEN=
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=

# Optional. Set this to your test server's ID (right-click the server icon
# in Discord with Developer Mode on -> Copy Server ID) to also sync slash
# commands to that one server instantly. Without it, command changes only
# sync globally, which Discord can take up to an hour to propagate.
DEV_GUILD_ID=
